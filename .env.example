# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Postgres with the pgvector extension (Neon free tier works: https://neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GUEST_DAILY_MESSAGES=20
USER_DAILY_MESSAGES=100
